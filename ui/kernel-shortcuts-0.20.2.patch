@@ -0,0 +1,28 @@
+import { BACKEND_CHANNEL_COMMAND, BACKEND_GOAL_COMMAND, BACKEND_PERMISSION_COMMAND, completeCommands, isLocalCommandName } from '../commands.js';
+/** An installed backend can offer a shortcut for kernel selection. Its native
+ * slash namespace, existing commands/skills and ambiguous names always win. */
+export function kernelCommandMenu(entries, channel) {
+    const names = new Map();
+    for (const { kernelShortcut } of entries) {
+        if (kernelShortcut)
+            names.set(kernelShortcut, (names.get(kernelShortcut) ?? 0) + 1);
+    }
+    const targets = new Map();
+    const shortcuts = [];
+    const existing = channel.commandList;
+    const reserved = new Set([BACKEND_CHANNEL_COMMAND, BACKEND_GOAL_COMMAND, BACKEND_PERMISSION_COMMAND, ...existing].map(row => row.name.toLowerCase()));
+    for (const { id, kernelShortcut: name, shortLabel } of entries) {
+        if (!name || names.get(name) !== 1 || isLocalCommandName(name) || reserved.has(name))
+            continue;
+        targets.set(name, id);
+        shortcuts.push({ name, description: `Switch to the ${shortLabel} kernel`, descriptions: { zh: `切换到 ${shortLabel} 内核` } });
+    }
+    return {
+        targets,
+        commandList: shortcuts.length ? [...existing, ...shortcuts] : existing,
+        commandCompletions(input) {
+            const rows = channel.commandCompletions(input);
+            return shortcuts.length ? [...rows, ...completeCommands(input, shortcuts)] : rows;
+        },
+    };
+}
