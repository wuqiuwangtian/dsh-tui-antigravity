+import { type LocalCommand } from '../commands.js';
+import type { KernelEntry } from './kernelCatalog.js';
+import type { ChannelUi } from '../adapter/channel/ui-policy.js';
+/** An installed backend can offer a shortcut for kernel selection. Its native
+ * slash namespace, existing commands/skills and ambiguous names always win. */
+export declare function kernelCommandMenu(entries: readonly KernelEntry[], channel: Pick<ChannelUi, 'commandList' | 'commandCompletions'>): {
+    targets: Map<string, string>;
+    commandList: readonly LocalCommand[];
